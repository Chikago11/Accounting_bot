# Пример файла .env
# Скопируй в .env и подставь свои значения

# токен бота из BotFather
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# имя таблицы в Google Sheets
SPREADSHEET_NAME=name of your google sheet

# JSON-файл сервисного аккаунта Google (путь относительно папки бота)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Telegram ID тех, кому можно пользоваться ботом, через запятую
ALLOWED_USER_IDS=123456789,987654321

# Голосовой ввод. Без включения дополнительные параметры не нужны.
VOICE_INPUT_ENABLED=false
VOICE_DEFAULT_CURRENCY=THB
VOICE_TIMEZONE=Asia/Bangkok
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_FILE_BYTES=10000000
VOICE_MAX_OPERATIONS=10
VOICE_MAX_AMOUNT=10000000
VOICE_PENDING_TTL_SECONDS=900
HERMES_TIMEOUT_SECONDS=180
# Аргументы программы, принимающей JSON через stdin и возвращающей JSON.
# Установите scripts/hermes_voice_bridge.py внутрь существующего контейнера Hermes.
# VOICE_BRIDGE_COMMAND='["docker","exec","-i","hermes-agent-owxa-hermes-agent-1","/opt/hermes/.venv/bin/python","/opt/data/scripts/accounting_voice_bridge.py"]'
# VOICE_DATA_DIR=/home/alfred/projects/Accounting_bot/data
# VOICE_CATEGORY_ALIASES_FILE=/home/alfred/projects/Accounting_bot/category_aliases.json
