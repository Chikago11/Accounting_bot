# Пример файла .env
# Скопируй в .env и подставь свои значения

# токен бота из BotFather
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# имя таблицы в Google Sheets
SPREADSHEET_NAME=name of your google sheet

# JSON-файл сервисного аккаунта Google (путь относительно папки бота)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Telegram ID тех, кому можно пользоваться ботом, через запятую
ALLOWED_USER_IDS=123456789,987654321
